   "name": "What is Ebenezer Missionary Baptist Church?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Historic Bronzeville Missionary Baptist congregation. Neighborhood: Grand Boulevard. Years active: 1900s\u2013contemporary."
   }
  },
  {
   "@type": "Question",
   "name": "What is Evangelical Bethel Church of Chicago?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Haitian congregation in Chicago's Rogers Park neighborhood, sharing the Rogers Park Baptist Church building at 1900 W. Greenleaf Avenue. Documented by the Rogers Park/West Ridge Historical Society among Rogers Park churches; the building is also shared by the Spanish congregation Cristo En La Ciudad."
   }
  },
