{
  "@context": "https://schema.org",
  "@type": "Dataset",
  "name": "FC300 \u2014 Black Fictional Characters Registry",
  "identifier": "CTL-DS-FC3-000001",
  "creator": {
    "@type": "Organization",
    "name": "CultureTechLens NFP"
  },
  "license": "https://creativecommons.org/licenses/by/4.0/",
  "description": "300 Black fictional characters across seven mediums (Television 70, Film 60, Comics & Superheroes 50, Animation 40, Literature & Books 40, Video Games 25, Theater & Stage 15), each with creator, first appearance, portrayer, coverage status, citation, and a full AEO layer. Only 139 characters have a Wikidata item of their own; 157 (52%) exist solely inside their franchise's page. Coverage Status is the dataset's evidence vocabulary, kept verbatim. Images are link-only by design \u2014 the dataset distributes metadata and citations, never image files.",
  "keywords": [
    "Black fictional characters",
    "representation",
    "Wikidata",
    "AEO",
    "film",
    "television",
    "comics",
    "CultureTechLens"
  ],
  "distribution": [
    {
      "@type": "DataDownload",
      "encodingFormat": "text/csv"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "application/json"
    },
    {
      "@type": "DataDownload",
      "encodingFormat": "application/x-sqlite3"
    }
  ]
}