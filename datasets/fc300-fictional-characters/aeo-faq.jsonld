   }
  },
  {
   "@type": "Question",
   "name": "Who was the first Black hero in a zombie movie?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Ben is the resourceful hero of Night of the Living Dead (1968), played by Duane Jones. He takes charge of strangers barricaded against the undead, making him a landmark Black lead in horror cinema."
   }
  },
  {
   "@type": "Question",
   "name": "Who was the nurse who took revenge in Coffy?",
   "acceptedAnswer": {
