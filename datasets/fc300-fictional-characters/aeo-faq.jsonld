  {
   "@type": "Question",
   "name": "Who played the piano in Casablanca?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Sam is the piano player at Rick's cafe in Casablanca (1942), played by Dooley Wilson. When Ilsa asks him to play As Time Goes By, his music unlocks the film's central love story and memory."
   }
  },
  {
   "@type": "Question",
   "name": "Who was chained to Tony Curtis in The Defiant Ones?",
   "acceptedAnswer": {
    "@type": "Answer",
    "text": "Noah Cullen is an escaped prisoner chained to a white fellow prisoner in The Defiant Ones (1958), played by Sidney Poitier. Their forced partnership made the film a landmark statement about racism and dependence."
   }
  },
  {
   "@type": "Question",
   "name": "Who led the wagon train in Buck and the Preacher?",
   "acceptedAnswer": {
    "@type": "Answer",
