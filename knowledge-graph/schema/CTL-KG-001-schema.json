 "id_rules": {
  "format": "CTL-<PREFIX>-<zero-padded sequence>",
  "stability": "IDs are assigned once, never reused, never changed",
  "topic_exception": "CTL-T-<lane-nn> reuses taxonomy lane numbers"
 },
